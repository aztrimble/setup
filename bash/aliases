# Change behavior of cp and mv for safety
alias cp='cp -vi'
alias mv='mv -vi'

# List command: ls
alias lsd='ls -lh'
alias lsa='ls -A'

# Verbose copying with rsync
alias cpv='rsync -avh --info=progress2'

# Quick update
alias qupdate='. ~/SetupFiles/SetupScripts/1.0.update_full.bash'

# Find a sting in a file. NOTE: this command only works in bash not in zsh.
fstr() {
  grep -Rnw "." -e "$1"
}

# Enable ssh-agent and add key
alias gitssh="eval '$(ssh-agent -s)' && ssh-add ~/.ssh/github-key"
alias gitssh-off="eval '$(ssh-agent -k)'"
