## Change behavior of cp and mv for safety
### Standard copy and move commands
alias cp='cp -vi'
alias mv='mv -vi'
### Verbose copying with rsync
alias cpv='rsync -avh --info=progress2'

## Add/modify some ls aliases
alias ll='ls -AlF'
alias lr='ls -Altr'

## Add some aliases to simplify administrative tasks.
### Easier access to xdg-open
alias open='xdg-open'
### Quick update
alias qupdate='. ~/SetupFiles/SetupScripts/1.0.update_full.bash'
### Find a sting in a file. NOTE: this command only works in bash not in zsh.
fstr() {
  grep -Rnw "." -e "$1"
}

